@inject IConfiguration Config
@{
    var returnUrl = Uri.EscapeDataString(Context.Request.Path.Value + Context.Request.QueryString.Value);
    var otherCode = L.IsRtl ? "en" : "ar";
    var otherName = L.IsRtl ? "English" : "العربية";
}
<!DOCTYPE html>
<html lang="@L.Code" dir="@L.Dir">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MindMirror</title>
    <meta name="description" content="@(ViewData["Description"] ?? L.T("site.description"))" />
    <meta name="theme-color" content="#7c3aed" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&family=Playfair+Display:wght@600;700&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <script src="~/js/theme.js"></script>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <div class="crisis-bar">
        @L.T("crisis.text") <strong>@Config["Crisis:Emergency"]</strong>
        &nbsp;·&nbsp; <a asp-page="/Help">@L.T("crisis.more")</a>
    </div>

    <header class="site-header">
        <a class="logo" asp-page="/Index">MindMirror</a>
        <nav>
            <a asp-page="/Index">@L.T("nav.home")</a>
            <a asp-page="/Articles">@L.T("nav.articles")</a>
            <a asp-page="/Conditions/Index">@L.T("nav.conditions")</a>
            <a asp-page="/SelfCheck">@L.T("nav.selfcheck")</a>
            <a asp-page="/Tools/Index">@L.T("nav.toolkit")</a>
            <a asp-page="/Resources">@L.T("nav.directory")</a>
            <a asp-page="/Hospitals">@L.T("nav.hospitals")</a>
            <a asp-page="/Help">@L.T("nav.help")</a>
            <a class="lang-btn" href="/set-language?lang=@otherCode&returnUrl=@returnUrl" lang="@otherCode" hreflang="@otherCode">@otherName</a>
            <button id="theme-toggle" class="icon-btn" type="button" aria-label="@L.T("nav.theme")">🌓</button>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>@L.T("footer.disclaimer")</p>
        <p class="footer-links">
            <a asp-page="/Privacy">@L.T("footer.privacy")</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a asp-page="/Admin/Index">@L.T("footer.adminpanel")</a>
            }
            else
            {
                <a asp-page="/Admin/Login">@L.T("footer.admin")</a>
            }
        </p>
        <p>&copy; @DateTime.Now.Year MindMirror</p>
    </footer>
        <script src="~/js/i18n.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>